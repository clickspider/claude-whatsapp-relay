<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>__LABEL__.watchdog</string>
  <key>ProgramArguments</key><array>
    <string>__PYTHON__</string>
    <string>-I</string>
    <string>__WATCHDOG__</string>
    <string>--config</string>
    <string>__CONFIG__</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__LOG_DIR__/watchdog.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/watchdog.log</string>
</dict></plist>
